<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Hryvinskyi\BotBlocker\Model\ConfigInterface"
                type="Hryvinskyi\BotBlocker\Model\Config"/>
    <preference for="Hryvinskyi\BotBlocker\Model\IpStorageInterface"
                type="Hryvinskyi\BotBlocker\Model\IpStorage"/>
    <preference for="Hryvinskyi\BotBlocker\Model\BanBadIpInterface"
                type="Hryvinskyi\BotBlocker\Model\BanBadIp"/>
    <preference for="Hryvinskyi\BotBlocker\Api\PreBootstrapConfigExporterInterface"
                type="Hryvinskyi\BotBlocker\Model\PreBootstrapConfigExporter"/>

    <type name="Hryvinskyi\BotBlocker\Model\Config">
        <arguments>
            <argument name="serializer" xsi:type="object">Magento\Framework\Serialize\Serializer\Json</argument>
        </arguments>
    </type>

    <type name="Hryvinskyi\BotBlocker\Model\Validator\BotBlockerValidator">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="is_white_list" xsi:type="array">
                    <item name="object" xsi:type="object">Hryvinskyi\BotBlocker\Model\Validator\IsWhitelistedValidator</item>
                    <item name="sortOrder" xsi:type="string">10</item>
                </item>
                <item name="is_banned" xsi:type="array">
                    <item name="object" xsi:type="object">Hryvinskyi\BotBlocker\Model\Validator\IsBannedValidator</item>
                    <item name="sortOrder" xsi:type="string">100</item>
                </item>
                <item name="no_route_threshold" xsi:type="array">
                    <item name="object" xsi:type="object">Hryvinskyi\BotBlocker\Model\Validator\NoRouteThresholdValidator</item>
                    <item name="sortOrder" xsi:type="string">130</item>
                </item>
                <item name="search_page_threshold" xsi:type="array">
                    <item name="object" xsi:type="object">Hryvinskyi\BotBlocker\Model\Validator\SearchPageThresholdValidator</item>
                    <item name="sortOrder" xsi:type="string">140</item>
                </item>
                <item name="filter_page_threshold" xsi:type="array">
                    <item name="object" xsi:type="object">Hryvinskyi\BotBlocker\Model\Validator\FilterPageThresholdValidator</item>
                    <item name="sortOrder" xsi:type="string">150</item>
                </item>
                <item name="threshold" xsi:type="array">
                    <item name="object" xsi:type="object">Hryvinskyi\BotBlocker\Model\Validator\ThresholdValidator</item>
                    <item name="sortOrder" xsi:type="string">200</item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Hryvinskyi\BotBlocker\Model\HandleStorage">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="mysql" xsi:type="object">Hryvinskyi\BotBlocker\Model\HandleStorage\MySQL</item>
                <item name="redis" xsi:type="object">Hryvinskyi\BotBlocker\Model\HandleStorage\Redis</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\BotBlocker\Model\Validator\NoRouteThresholdValidator">
        <arguments>
            <argument name="detector" xsi:type="object">Hryvinskyi\BotBlocker\Model\RestrictedPageDetector\NoRouteDetector</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\BotBlocker\Model\Validator\SearchPageThresholdValidator">
        <arguments>
            <argument name="detector" xsi:type="object">Hryvinskyi\BotBlocker\Model\RestrictedPageDetector\SearchPageDetector</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\BotBlocker\Model\Validator\FilterPageThresholdValidator">
        <arguments>
            <argument name="detector" xsi:type="object">Hryvinskyi\BotBlocker\Model\RestrictedPageDetector\FilterPageDetector</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\BotBlocker\Model\HandleStorage\Redis">
        <arguments>
            <!-- We use serialisation instead of json because serialisation is faster -->
            <argument name="serializer" xsi:type="object">Magento\Framework\Serialize\Serializer\Serialize</argument>
        </arguments>
    </type>
</config>
