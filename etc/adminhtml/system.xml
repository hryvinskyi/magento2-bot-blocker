<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="hryvinskyi_bot_blocker" sortOrder="200" showInDefault="1">
            <class>separator-top</class>
            <label>Bot Blocker</label>
            <tab>hryvinskyi</tab>
            <resource>Hryvinskyi_BotBlocker::config</resource>
            <group id="general" translate="label" type="text" sortOrder="40" showInDefault="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="storage_method" translate="label" type="select" sortOrder="20" showInDefault="1">
                    <label>Storage Method</label>
                    <source_model>Hryvinskyi\BotBlocker\Model\Config\Source\StorageMethod</source_model>
                </field>
                <field id="threshold" translate="label,comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Threshold</label>
                    <comment>Set the maximum number of requests an IP address can make within a specified timeframe before it is blocked.</comment>
                </field>
                <field id="timeframe" translate="label,comment" type="text" sortOrder="40" showInDefault="1">
                    <label>Timeframe</label>
                    <comment>Define the time window during which the threshold count is calculated (in seconds).</comment>
                </field>
                <field id="block_time" translate="label,comment" type="text" sortOrder="50" showInDefault="1">
                    <label>Block Time</label>
                    <comment>Set the time an IP address is blocked for after reaching the threshold (in seconds).</comment>
                </field>
                <field id="user_agent_override" translate="label,comment" sortOrder="50" showInDefault="1">
                    <label>Override limits by User Agent</label>
                    <comment>Specify a list of user agents to override the Threshold and Timeframe limits for them</comment>
                    <frontend_model>Hryvinskyi\BotBlocker\Block\Adminhtml\Form\Field\UserAgent</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>

                <field id="whitelist" translate="label,comment" type="textarea" sortOrder="60" showInDefault="1">
                    <label>Whitelist</label>
                    <comment>Specify a list of IP addresses that should be exempt from the blocking rules (comma-separated).</comment>
                </field>
            </group>
            <group id="no_route_page" translate="label,comment" type="text" sortOrder="50" showInDefault="1">
                <label>404 (No Route) Page Rate Limiting</label>
                <comment>Apply stricter rate limits to 404/not-found pages to protect against aggressive crawling of non-existent URLs.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="threshold" translate="label,comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Threshold</label>
                    <comment>Maximum 404-page requests an IP can make within the timeframe before being blocked.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="timeframe" translate="label,comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Timeframe</label>
                    <comment>Time window in seconds for counting 404-page requests.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="block_time" translate="label,comment" type="text" sortOrder="40" showInDefault="1">
                    <label>Block Time</label>
                    <comment>Duration in seconds to block an IP after exceeding the 404-page threshold.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="search_page" translate="label,comment" type="text" sortOrder="60" showInDefault="1">
                <label>Search Page Rate Limiting</label>
                <comment>Apply stricter rate limits to catalog search result pages to protect against search abuse.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="threshold" translate="label,comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Threshold</label>
                    <comment>Maximum search-page requests an IP can make within the timeframe before being blocked.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="timeframe" translate="label,comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Timeframe</label>
                    <comment>Time window in seconds for counting search-page requests.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="block_time" translate="label,comment" type="text" sortOrder="40" showInDefault="1">
                    <label>Block Time</label>
                    <comment>Duration in seconds to block an IP after exceeding the search-page threshold.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="filter_page" translate="label,comment" type="text" sortOrder="70" showInDefault="1">
                <label>Filter Page Rate Limiting</label>
                <comment>Apply stricter rate limits to filtered category pages (layered navigation) to protect against aggressive filter crawling.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="threshold" translate="label,comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Threshold</label>
                    <comment>Maximum filter-page requests an IP can make within the timeframe before being blocked.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="timeframe" translate="label,comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Timeframe</label>
                    <comment>Time window in seconds for counting filter-page requests.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="block_time" translate="label,comment" type="text" sortOrder="40" showInDefault="1">
                    <label>Block Time</label>
                    <comment>Duration in seconds to block an IP after exceeding the filter-page threshold.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
